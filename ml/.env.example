# Inference service configuration.
# Copy to ml/.env for local Docker Compose, or set these as environment
# variables in your host (Cloud Run / Render / Railway / Azure).

# Supabase project — use the SAME values as the web application.
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Shared secret between the web app and this service.
# Set an identical value as ML_SERVICE_TOKEN in the web app (Vercel).
# Leave blank only for isolated local testing.
ML_SERVICE_TOKEN=

# Writable directory where verified active artifacts are cached on startup.
ARTIFACT_DIR=/tmp/artifacts

# Port the service listens on. Cloud Run / Render / Railway override this.
PORT=8000
