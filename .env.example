# Browser-safe Supabase project values
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. Required for account administration, model registration, and
# verified offline training from a committed private import.
SUPABASE_SERVICE_ROLE_KEY=

# Optional embedded Power BI report. Leave blank until a real report is published.
NEXT_PUBLIC_POWER_BI_REPORT_URL=

# Required for Batch Predictions. Both values are server-only; ML_SERVICE_TOKEN
# must match the separately deployed FastAPI service and must never use a
# NEXT_PUBLIC_ prefix.
ML_SERVICE_URL=http://127.0.0.1:8000
ML_SERVICE_TOKEN=
